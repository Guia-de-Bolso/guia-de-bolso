# Copie para .env.local e preencha. Na Vercel, use os MESMOS nomes (prefixo NEXT_PUBLIC_).

NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
# Chave anon ou publishable (Settings → API Keys no Supabase) — NÃO use service_role aqui
NEXT_PUBLIC_SUPABASE_ANON_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Opcional — local: http://localhost:3000 · produção: https://guiadebolso.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# OAuth Google no app Android — Web Client ID (mesmo do Supabase → Auth → Google)
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# OAuth Google no app iOS — iOS Client ID (bundle app.guiadebolso) + reversed scheme no ios/GoogleAuth.xcconfig
NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=
NEXT_PUBLIC_OPENWEATHER_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional — senha do Postgres para scripts locais (Settings → Database no Supabase)
SUPABASE_DB_PASSWORD=
# Cron Vercel — purge de locais inativos (30 dias). Gere um valor aleatório longo.
CRON_SECRET=

# Google Play — assinatura Guia Premium (Android)
# Product ID e Base Plan ID criados em Play Console → Monetize → Subscriptions
NEXT_PUBLIC_PLAY_PREMIUM_PRODUCT_ID=guia_premium_mensal
NEXT_PUBLIC_PLAY_PREMIUM_BASE_PLAN_ID=monthly
# Service account JSON (uma linha) com acesso à Android Publisher API — só servidor
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Opcional — default: app.guiadebolso
GOOGLE_PLAY_PACKAGE_NAME=app.guiadebolso

# App Store — assinatura Guia Premium (iOS)
# Product ID criado em App Store Connect → Subscriptions
NEXT_PUBLIC_APPLE_PREMIUM_PRODUCT_ID=guia_premium_mensal
# Chave In-App Purchase (.p8) — Users and Access → Integrations → In-App Purchase
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
# Cole a chave .p8 completa (com BEGIN/END) ou só o conteúdo interno — o servidor normaliza
APPLE_IAP_PRIVATE_KEY=
# Opcional — default: app.guiadebolso
APPLE_IAP_BUNDLE_ID=app.guiadebolso
# true = validar só sandbox (TestFlight / review). Remova ou false em produção.
APPLE_IAP_USE_SANDBOX=false
